@startuml
' Use case diagram for the Food Ordering System

left to right direction

title Use Case Diagram: Food Ordering System

actor Customer
actor Admin
actor "Kitchen Staff" as Kitchen

rectangle "Food Ordering System" {
  ' Customer Use Cases
  usecase "Register / Login" as UC_Auth
  usecase "Browse Menu" as UC_Browse
  usecase "Search for Food" as UC_Search
  usecase "Manage Cart" as UC_Cart
  usecase "Place Order" as UC_Order
  usecase "Track Order Status" as UC_Track
  usecase "View Order History" as UC_History
  usecase "Manage Profile" as UC_Profile

  ' Admin Use Cases
  usecase "Manage Categories" as UC_ManageCat
  usecase "Manage Food Items" as UC_ManageFood
  usecase "Manage Orders" as UC_ManageOrders
  usecase "View Customers" as UC_ViewCust
  usecase "Manage Suppliers" as UC_ManageSuppliers
  usecase "Manage Raw Materials" as UC_ManageRaw
  usecase "View Sales Reports" as UC_Reports

  ' Kitchen Staff Use Cases
  usecase "View Incoming Orders" as UC_ViewOrders
  usecase "Update Order Status" as UC_UpdateStatus
}

' Actor to Use Case relationships
Customer -- UC_Auth
Customer -- UC_Browse
Customer -- UC_Search
Customer -- UC_Cart
Customer -- UC_Order
Customer -- UC_Track
Customer -- UC_History
Customer -- UC_Profile

Admin -- UC_ManageCat
Admin -- UC_ManageFood
Admin -- UC_ManageOrders
Admin -- UC_ViewCust
Admin -- UC_ManageSuppliers
Admin -- UC_ManageRaw
Admin -- UC_Reports

Kitchen -- UC_ViewOrders
Kitchen -- UC_UpdateStatus

' Relationships between Use Cases
UC_Order ..> UC_Cart : <<include>>
UC_Browse ..> UC_Search : <<extend>>
UC_ManageOrders ..> UC_UpdateStatus : <<extend>>
UC_ManageFood ..> UC_ManageCat : <<include>>

@enduml